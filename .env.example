# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project URL (no /rest/v1 at the end)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public, read-only key: Supabase dashboard -> Settings -> API Keys -> Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (bypasses Row Level Security). Never prefix with NEXT_PUBLIC_.
# Used for booking requests and the admin.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin (browser sign-in box; any username). At least 8 characters.
# Leave empty to keep /admin locked.
ADMIN_PASSWORD=
